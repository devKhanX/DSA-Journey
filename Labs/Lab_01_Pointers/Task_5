#include <iostream>
using namespace std;
int main()
{
    int n;
    cout<<"Enter size of array: ";
    cin>>n;
    int *arr=new int[n];
    for (int i=0;i<n;i++)
    {
        cin>>*(arr + i);
    }
    int *ptr=arr+n-1;
    for(int i=0;i<n;i++)
    {
        cout<<*ptr<<endl;
        ptr--;
    }
    delete[] arr;
    return 0;
}
